#
#
####################################################################################################

####################################################################################################
# RPG STRATEGY
#

# Randombots will behave more like real players (experimental)
# This option will override Playerbots.AutoDoQuests
# Default: 1 (enabled)
Playerbots.EnableNewRpgStrategy = 1

# Radius (yards) of the new RPG strategy's NPC and gameobject scans. Cost grows with the square of the radius.
# Default: 150.0
Playerbots.RpgTargetSearchDistance = 150.0

# Track per-quest accept/complete/reward/drop/abandon counts and drop/abandon reasons, reported by
# ".playerbots rndbot queststats" and dumped to LogsDir/playerbots_quest_stats.json by
# ".playerbots rndbot questdump". Adds per-bot maps that are cleared on every stats aggregation.
# Default: 0 (disabled)
Playerbots.CollectDetailedQuestStats = 0

# Control probability weights for RPG status of bots. Takes effect only when the status meets its premise.​
# Sum of weights need not be 100. Set to 0 to disable the status.
#
# WanderRandom  (Default: 15  Move randomly nearby to find and kill mobs)
# WanderNpc     (Default: 20  Randomly interact with nearby NPCs​)
# GoGrind       (Default: 15  Go to nearby level-appropriate locations to grind for killing mobs)
# GoCamp        (Default: 10  Return to a nearby camp depending on innkeeper/flightmaster)​
# DoQuest       (Default: 60  Select quest from the quest log and head to the location to attempt completion​)
# TravelFlight  (Default: 15  Go to the nearest flightmaster and fly to a level-appropriate area)
# Rest          (Default: 5   Take a break for a while and do nothing)
# OutdoorPvp    (Default: 10  Participate in outdoor PvP capture points if already in an outdoor PvP zone)
# DoGather      (Default: 15  Roam the current zone harvesting herb/ore nodes; requires Herbalism or Mining)
Playerbots.RpgStatusProbWeight.WanderRandom = 15
Playerbots.RpgStatusProbWeight.WanderNpc = 20
Playerbots.RpgStatusProbWeight.GoGrind = 15
Playerbots.RpgStatusProbWeight.GoCamp = 10
Playerbots.RpgStatusProbWeight.DoQuest = 60
Playerbots.RpgStatusProbWeight.TravelFlight = 15
Playerbots.RpgStatusProbWeight.Rest = 5
Playerbots.RpgStatusProbWeight.OutdoorPvp = 10
Playerbots.RpgStatusProbWeight.DoGather = 15

